# Copier ce fichier en ".env" puis compléter. Le fichier .env n'est jamais versionné.

# Mode de l'application : "demo" (données fictives) ou "cabinet" (installation locale)
OPTIFISC_MODE=cabinet

# IA : "openrouter" ou "desactivee" (l'application fonctionne entièrement sans IA)
OPTIFISC_IA=openrouter

# Clé personnelle OpenRouter (https://openrouter.ai/keys) — à coller ici, jamais dans le code ni dans un message
OPENROUTER_API_KEY=

# UNIQUEMENT des modèles gratuits (suffixe :free) : un modèle payant est refusé par l'application.
# Assistant CGI : rédiger en français à partir des articles fournis → modèle multilingue
OPENROUTER_MODELE_ASSISTANT=google/gemma-4-31b-it:free
# Agent de propositions : raisonner en plusieurs étapes et suivre le protocole JSON → modèle de planification
OPENROUTER_MODELE_AGENT=nvidia/nemotron-3-super-120b-a12b:free
# Modèles de secours (gratuits, séparés par des virgules) : si le modèle principal est saturé (erreur 429),
# OpenRouter bascule automatiquement sur le suivant. Le modèle principal est retiré de la liste s'il y figure.
# Varier les FOURNISSEURS (Google, Nvidia) : quand Google sature, tous ses modèles gratuits saturent ensemble.
OPENROUTER_MODELES_SECOURS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free

# Dossiers réels : autoriser l'envoi du profil pseudonymisé à OpenRouter (non par défaut, doc 01 A.3)
OPTIFISC_IA_DOSSIERS_REELS=non
